# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交私钥）

# Infura Sepolia 节点地址，将 YOUR_API_KEY 替换为你在 Infura 控制台获取的 API Key
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# 发送方账户私钥（仅使用测试账户！可带或不带 0x 前缀）
PRIVATE_KEY=

# 默认接收方地址（也可通过 -to 参数指定）
TO_ADDRESS=

# 任务二：已部署的 Counter 合约地址（首次运行 -deploy 后填入）
COUNTER_ADDRESS=
