{
    "swagger": "2.0",
    "info": {
        "description": "Go + Gin + GORM 实现的个人博客后端微服务，提供用户认证、文章管理、评论管理接口。",
        "title": "个人博客后端 API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
