{
  "name": "nft-auction-market",
  "version": "1.0.0",
  "description": "基于 Hardhat 3 的 NFT 拍卖市场：Chainlink 价格预言机 + UUPS 可升级 + 动态手续费",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "upgrade:local": "hardhat run scripts/upgrade.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia --build-profile production",
    "upgrade:sepolia": "hardhat run scripts/upgrade.ts --network sepolia --build-profile production",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia --build-profile production",
    "demo:local": "hardhat run scripts/demo.ts --network localhost",
    "demo:sepolia": "hardhat run scripts/demo.ts --network sepolia --build-profile production"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.1.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.0",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "hardhat": "^3.17.0",
    "mocha": "^11.8.0",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
